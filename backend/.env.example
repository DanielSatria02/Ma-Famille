# Copy to .env
APP_NAME=ma-famille-api
APP_ENV=development
API_V1_PREFIX=/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+psycopg://mafamille:mafamille@localhost:5432/mafamille
# DOKU sandbox (https://sandbox.doku.com) — leave empty to keep 501 stubs
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
# Empty = open (local dev). Production sets a random token.
MANAGER_TOKEN=
# Password for POST /auth/login (manager dashboard). Empty = login disabled.
MANAGER_PASSWORD=
# Lifetime of a token issued by /auth/login, in minutes.
MANAGER_SESSION_MINUTES=480
# Pending bookings older than this are auto-cancelled on next read/write.
BOOKING_TTL_MINUTES=30
# Guest notifications. log = record the message (server log + DB row) without
# delivering anything — the honest default for dev. Set to smtp (fill SMTP_HOST…)
# or whatsapp (fill WHATSAPP_TOKEN / WHATSAPP_PHONE_ID) to actually deliver.
NOTIFY_TRANSPORT=log
NOTIFY_FROM=no-reply@ma-famille.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
